#!/bin/sh
#
# pre-push, installed per clone into its shared .git/hooks (and so its lane worktrees) by
# UnityJigs Lanes~/githooks/install.sh.
#
# 1) Refuse to push lane branches (lane-a … lane-j): the scratch branches of the lane worktrees
#    (<worktree root>/<repo>-<id>, Lanes~/README.md). Their work reaches
#    the remote by being merged into a real branch, never as lane-x itself.
# 2) Then Git LFS's own pre-push, fed the same ref list (it uploads the LFS objects).
#
# Bypass intentionally with:  git push --no-verify

# A closed stderr (e.g. `git commit 2>&1 | head -1`) must not kill this hook mid-message: on Git for Windows
# a SIGPIPE death reads as success and the commit/push goes through.
trap '' PIPE

refs=$(cat)

blocked=$(printf '%s\n' "$refs" | while read -r local_ref local_sha remote_ref remote_sha; do
    for ref in "$local_ref" "$remote_ref"; do
        case "$ref" in
            refs/heads/lane-[a-jA-J]) echo "  ${ref#refs/heads/}"; break ;;
        esac
    done
done)

if [ -n "$blocked" ]; then
    echo "" >&2
    echo "Push blocked: lane branches stay local." >&2
    echo "$blocked" | sort -u >&2
    echo "Merge the lane's work into your own branch and push that" >&2
    echo "(or, intentionally, bypass with: git push --no-verify)." >&2
    echo "" >&2
    exit 1
fi

command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
printf '%s\n' "$refs" | git lfs pre-push "$@"
