#!/bin/sh
#
# pre-commit, installed per clone into its shared .git/hooks (and so its lane worktrees) by
# UnityJigs Lanes~/githooks/install.sh.
#
# Blocks LOCAL "file:" Unity package references that point OUTSIDE the repository in
# Packages/manifest.json or packages-lock.json: absolute ones ("file:D:/Clones/SomePackage") and relative
# ones that climb out of the repo ("file:../../../SomePackage", what PackageSwitcher's Switch To Local
# writes). They work only on a machine with that clone beside the repo; a teammate without it breaks on
# pull. Packages inside the repo are allowed — embedded ("file:Reflections") or elsewhere in it
# ("file:../../AtProtoUnity" from a project in a subfolder). No-op in non-Unity repos.
#
# Bypass intentionally with:  git commit --no-verify

# A closed stderr (e.g. `git commit 2>&1 | head -1`) must not kill this hook mid-message: on Git for Windows
# a SIGPIPE death reads as success and the commit/push goes through.
trap '' PIPE

# Is the relative file: path $2, resolved from the repo-relative folder $1, outside the repository?
# Pure text: every ".." pops a folder, and popping past the repo root means outside.
outside_repo() {
    printf '%s/%s\n' "$1" "$2" | tr '\\' '/' | awk -F/ '{
        d = 0
        for (i = 1; i <= NF; i++) {
            if ($i == "" || $i == ".") continue
            if ($i == "..") { if (--d < 0) { print "out"; exit } } else d++
        }
    }' | grep -q out
}

status=0
for f in $(git ls-files '*Packages/manifest.json' '*Packages/packages-lock.json'); do
    # Inspect the staged (about-to-be-committed) copy, not the working tree.
    dir=$(dirname "$f")
    bad=$(git show ":$f" 2>/dev/null | grep -nE '"file:[^"]*"' | while IFS= read -r line; do
        path=$(printf '%s\n' "$line" | sed -E 's/.*"file:([^"]*)".*/\1/')
        case "$path" in
            [A-Za-z]:* | /* | \\*) printf '%s\n' "$line" ;;                        # absolute
            *..*) outside_repo "$dir" "$path" && printf '%s\n' "$line" ;;          # climbs out of the repo?
        esac
    done)
    [ -z "$bad" ] && continue
    echo "ERROR: local 'file:' package reference outside the repository staged in $f" >&2
    echo "$bad" | sed 's/^/         /' >&2
    status=1
done

if [ "$status" -ne 0 ]; then
    echo "" >&2
    echo "Commit blocked. Switch the package back to its remote ref (PackageSwitcher: Switch To Remote) first" >&2
    echo "(or, intentionally, bypass with: git commit --no-verify)." >&2
    exit 1
fi

exit 0
